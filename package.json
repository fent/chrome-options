{
  "name": "chrome-options",
  "main": "dist/chrome-options.min.js",
  "version": "1.0.0",
  "description": "Options page for your Chrome extension",
  "author": "fent (https://github.com/fent)",
  "keywords": [
    "chrome",
    "extension",
    "options"
  ],
  "homepage": "https://github.com/fent/chrome-options",
  "repository": {
    "type": "git",
    "url": "git://github.com/fent/chrome-options.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "node build.js",
    "build:dev": "node build.js --dev",
    "watch": "node build.js --watch",
    "test": "mocha --exit test/*-test.js"
  },
  "standard-version": {
    "commitAll": true,
    "scripts": {
      "postbump": "node build.js && git add dist/"
    }
  },
  "ignore": [
    "images",
    "src",
    "node_modules"
  ],
  "devDependencies": {
    "c-p": "github:tovic/color-picker#1722fec9b8564eaf3b56b00a2b608d29ce129087",
    "chrome-bootstrap": "^1.5.0",
    "dragula": "^3.7.2",
    "esbuild": "^0.25.0",
    "lightdown": "^0.5.3",
    "mocha": "^12.0.3",
    "puppeteer-core": "^25.16.0"
  }
}
